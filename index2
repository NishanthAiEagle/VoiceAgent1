<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Bistro Voice Host</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @keyframes pulse-ring {
      0% { transform: scale(0.95); opacity: 0.8; }
      50% { transform: scale(1.15); opacity: 0.3; }
      100% { transform: scale(0.95); opacity: 0.8; }
    }
    .pulsing-ring {
      animation: pulse-ring 2s infinite ease-in-out;
    }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 flex flex-col items-center justify-between min-h-screen p-6 font-sans select-none">

  <!-- Top bar with key config button -->
  <div class="w-full flex justify-end">
    <button 
      id="keyConfigBtn" 
      class="text-xs text-slate-400 bg-slate-900 border border-slate-800 hover:border-amber-500/50 px-3 py-1.5 rounded-lg flex items-center gap-1.5 transition active:scale-95"
    >
      🔑 <span id="keyStatus">Set API Key</span>
    </button>
  </div>

  <!-- Header -->
  <header class="text-center pt-2">
    <div class="inline-flex items-center gap-2 px-3 py-1 bg-amber-500/10 border border-amber-500/30 rounded-full text-amber-400 text-xs font-semibold mb-3">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
      Live Voice Host
    </div>
    <h1 class="text-3xl font-extrabold text-slate-100 tracking-tight">The Spice Bistro</h1>
    <p class="text-sm text-slate-400 mt-1">Ask for dish recommendations, spice levels, or table reservations.</p>
  </header>

  <!-- Interactive Mic & Visualizer -->
  <main class="flex flex-col items-center w-full max-w-sm my-auto">
    <div class="relative flex items-center justify-center">
      <!-- Animated backdrop glow ring -->
      <div id="glowRing" class="absolute w-44 h-44 rounded-full bg-amber-500/20 blur-xl transition-all duration-500"></div>

      <!-- Main Orb Button -->
      <button 
        id="micBtn" 
        class="relative z-10 w-32 h-32 rounded-full bg-gradient-to-tr from-amber-500 to-amber-300 text-slate-950 flex items-center justify-center text-4xl shadow-xl shadow-amber-500/20 hover:scale-105 active:scale-95 transition-all duration-300 focus:outline-none"
        aria-label="Tap to speak"
      >
        <span id="micIcon">🎙️</span>
      </button>
    </div>

    <!-- Status indicator -->
    <p id="status" class="text-xs uppercase tracking-widest text-slate-400 mt-8 font-semibold transition-colors">
      Tap the mic to talk
    </p>

    <!-- Live Conversation Output Box -->
    <div 
      id="conversationBox" 
      class="mt-4 p-5 rounded-2xl bg-slate-900/90 border border-slate-800/80 w-full text-sm text-slate-200 min-h-[110px] flex items-center justify-center text-center shadow-inner leading-relaxed transition-all"
    >
      "Do you have vegan curries?" or "Reserve a table for 4 tonight at 8 PM"
    </div>
  </main>

  <!-- Footer Info -->
  <footer class="text-xs text-slate-500 pb-2 text-center">
    Free Cloud Hosted • Powered by Gemini 3.6 Flash
  </footer>

  <script>
    // ================= CONFIGURATION =================
    const APPS_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbzcLqBXShlxJKxP3M9BDbDPMT3HTZf2nrxjWip9YvdI0-cKsakzDvSJPVBvNiia0DNGDA/exec";

    // Retrieve the API key securely from the user's browser localStorage
    function getStoredKey() {
      return localStorage.getItem("GEMINI_API_KEY") || "";
    }

    const RESTAURANT_KNOWLEDGE = `
You are "Aura", the warm AI voice host for 'The Spice Bistro' located in Indiranagar, Bengaluru.
Operating Hours: Mon-Sun from 12:00 PM to 11:00 PM.

MENU & DETAILS:
1. Paneer Tikka (₹320) - Vegetarian, Gluten-Free, Mild spice.
2. Wild Mushroom Risotto (₹420) - Vegetarian, Gluten-Free, can be made 100% Vegan upon request.
3. Coastal Fish Curry (₹490) - Non-Veg, Coconut & kokum gravy, Medium spice.
4. Garlic Butter Naan (₹60) - Freshly baked flatbread.
5. Chocolate Fondant (₹250) - Eggless dessert.

BEHAVIOR RULES:
- Always speak concisely in 1 or 2 warm, natural sentences suitable for spoken voice.
- When a customer wants to reserve or book a table, collect their Name, Date, Time, and Number of Guests.
- ONLY when you have collected all booking details (Name, Date, Time, Guests), respond strictly with this JSON format and nothing else:
  {"action":"book_table","name":"...","guests":...,"date":"...","time":"...","notes":"..."}
`;

    // ================= UI REFERENCES =================
    const micBtn = document.getElementById("micBtn");
    const micIcon = document.getElementById("micIcon");
    const glowRing = document.getElementById("glowRing");
    const statusText = document.getElementById("status");
    const convoBox = document.getElementById("conversationBox");
    const keyConfigBtn = document.getElementById("keyConfigBtn");
    const keyStatus = document.getElementById("keyStatus");

    function refreshKeyDisplay() {
      if (getStoredKey()) {
        keyStatus.innerText = "Key Saved ✓";
        keyStatus.classList.add("text-emerald-400");
      } else {
        keyStatus.innerText = "Set API Key";
        keyStatus.classList.remove("text-emerald-400");
      }
    }
    refreshKeyDisplay();

    keyConfigBtn.onclick = () => {
      const existing = getStoredKey();
      const entered = prompt("Enter your Gemini API Key (starts with AIzaSy...):", existing);
      if (entered !== null) {
        if (entered.trim()) {
          localStorage.setItem("GEMINI_API_KEY", entered.trim());
        } else {
          localStorage.removeItem("GEMINI_API_KEY");
        }
        refreshKeyDisplay();
      }
    };

    // ================= WEB SPEECH API SETUP =================
    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    let recognition;
    let isListening = false;

    if (SpeechRecognition) {
      recognition = new SpeechRecognition();
      recognition.continuous = false;
      recognition.interimResults = false;
      recognition.lang = "en-US";

      recognition.onstart = () => {
        isListening = true;
        micIcon.innerText = "⏳";
        glowRing.classList.add("pulsing-ring", "bg-amber-400/40");
        statusText.innerText = "Listening to you...";
        statusText.classList.remove("text-slate-400", "text-red-400");
        statusText.classList.add("text-amber-400");
      };

      recognition.onresult = async (event) => {
        const userText = event.results[0][0].transcript;
        convoBox.innerText = `"${userText}"`;
        statusText.innerText = "Aura is thinking...";
        statusText.classList.replace("text-amber-400", "text-blue-400");
        await handleGeminiQuery(userText);
      };

      recognition.onerror = (e) => {
        console.error("Speech Recognition Error:", e);
        resetUI();
        if (e.error === "not-allowed") {
          statusText.innerText = "Microphone permission blocked";
          statusText.classList.add("text-red-400");
        } else {
          statusText.innerText = "Didn't catch that. Tap to try again.";
        }
      };

      recognition.onend = () => {
        isListening = false;
        if (statusText.innerText.includes("Listening")) {
          resetUI();
        }
      };

      micBtn.onclick = () => {
        const key = getStoredKey();
        if (!key) {
          const userKey = prompt("Please enter your Gemini API Key first (from aistudio.google.com):");
          if (userKey && userKey.trim()) {
            localStorage.setItem("GEMINI_API_KEY", userKey.trim());
            refreshKeyDisplay();
          } else {
            return;
          }
        }

        if (isListening) {
          recognition.stop();
          resetUI();
        } else {
          try {
            recognition.start();
          } catch (err) {
            recognition.stop();
          }
        }
      };
    } else {
      statusText.innerText = "Please open this in Chrome or Edge for voice support.";
      statusText.classList.add("text-red-400");
      micBtn.disabled = true;
    }

    function resetUI() {
      micIcon.innerText = "🎙️";
      glowRing.classList.remove("pulsing-ring", "bg-amber-400/40");
      statusText.innerText = "Tap the mic to talk";
      statusText.className = "text-xs uppercase tracking-widest text-slate-400 mt-8 font-semibold transition-colors";
    }

    // ================= GEMINI INFERENCE & BOOKING =================
    async function handleGeminiQuery(query) {
      const apiKey = getStoredKey();
      if (!apiKey) {
        convoBox.innerText = "Missing API Key. Tap 'Set API Key' at the top.";
        statusText.innerText = "Missing Key";
        resetUI();
        return;
      }

      try {
        const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent?key=${apiKey}`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({
            contents: [
              {
                parts: [
                  { text: `${RESTAURANT_KNOWLEDGE}\n\nCustomer: ${query}` }
                ]
              }
            ]
          })
        });

        const result = await response.json();

        if (result.error) {
          throw new Error(result.error.message || "API Error");
        }

        const reply = result.candidates?.[0]?.content?.parts?.[0]?.text?.trim() || "Could you please rephrase that?";

        // Check if the response contains table booking JSON
        if (reply.startsWith("{") && reply.includes("book_table")) {
          const booking = JSON.parse(reply);
          await pushReservationToSheets(booking);
          const confirmation = `All set! Table for ${booking.guests} reserved for ${booking.name} at ${booking.time}.`;
          convoBox.innerText = confirmation;
          readAloud(confirmation);
        } else {
          convoBox.innerText = reply;
          readAloud(reply);
        }
      } catch (err) {
        console.error("Gemini request failed:", err);
        convoBox.innerText = `Error: ${err.message || "Failed to reach Gemini API."}`;
        statusText.innerText = "Connection Issue";
        statusText.classList.add("text-red-400");
        resetUI();
      }
    }

    // ================= LOG TO GOOGLE SHEETS =================
    async function pushReservationToSheets(details) {
      statusText.innerText = "Saving to reservation log...";
      try {
        await fetch(APPS_SCRIPT_URL, {
          method: "POST",
          mode: "no-cors",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(details)
        });
      } catch (err) {
        console.error("Sheets webhook error:", err);
      }
    }

    // ================= SPEECH SYNTHESIS (TTS) =================
    function readAloud(text) {
      if (!window.speechSynthesis) {
        resetUI();
        return;
      }
      window.speechSynthesis.cancel();
      const speech = new SpeechSynthesisUtterance(text);
      speech.rate = 1.0;
      speech.pitch = 1.0;

      speech.onstart = () => {
        statusText.innerText = "Aura is speaking...";
        statusText.classList.replace("text-blue-400", "text-emerald-400");
      };

      speech.onend = () => {
        resetUI();
      };

      window.speechSynthesis.speak(speech);
    }
  </script>
</body>
</html>